# Sử dụng Node.js 18 LTS làm base image
FROM node:18-alpine

# Thiết lập thư mục làm việc
WORKDIR /app

# Cài đặt dependencies cần thiết cho việc build
RUN apk add --no-cache python3 make g++

# Copy package.json và package-lock.json
COPY backend/package*.json ./

# Cài đặt dependencies (bao gồm dev dependencies)
RUN npm ci

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })" || exit 1

# Start application với nodemon cho development
CMD ["npm", "run", "comic"] 